# /etc/default/avianlink-relay: extra flags for avianlink-relay.
# After editing: sudo systemctl restart avianlink-relay
#
#   --retention-days N        how long packets are kept, 1-30 (default 7)
#   --mailbox-quota-kib N     space per mailbox (default 1024)
#   --total-quota-mib N       space in all (default 1024)
#   --push-service HOST:PORT  wake phones through avianlink-push (docs/push.md)
#
# The listening address is set in the unit (0.0.0.0:41000). For IPv6 too,
# override ExecStart with --bind [::]:41000 (systemctl edit avianlink-relay).

AVIANLINK_RELAY_ARGS="--retention-days 7"
#AVIANLINK_RELAY_ARGS="--retention-days 30 --total-quota-mib 8192 --push-service push.avianlink.dev:41001"
